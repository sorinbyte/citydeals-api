# ⚠️ THIS FILE IS COMMITTED TO GIT. Placeholders only — never paste a real connection string here.
# Real values go in .env, which is gitignored. Copy this file to .env and fill it in there.
#
# Neon gives you two connection strings and they are NOT interchangeable. In the Connect dialog,
# the "Connection pooling" toggle switches between them — the only difference is "-pooler" in the
# hostname.
#
# DATABASE_URL — the POOLED one (toggle ON, host contains "-pooler"). What the running API uses.
# DIRECT_URL   — the direct one (toggle OFF). Migrations and drizzle-kit go through this, because
#                schema changes don't work reliably through PgBouncer's transaction mode.
#
# Point these at the `development` branch while building. The production branch gets its values
# from the host's environment, never from a file.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=verify-full"
DIRECT_URL="postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=verify-full"

# `npm run db:seed` TRUNCATES every catalogue table, so it refuses to run without this.
# Fine in a local .env pointed at the development branch. Never set it in a deployed environment.
ALLOW_SEED="yes"

# ── Cloudflare R2 ────────────────────────────────────────────────────────────────────────────
#
# REQUIRED — the API refuses to boot without these. They used to be read only by
# `npm run assets:upload`, but the admin dashboard uploads venue photos through the API now, so
# they're validated at startup like everything else in src/lib/env.ts. A missing key should be a
# loud crash on boot, not a failed upload the first time someone drags a photo in.
#
# These are WRITE credentials. They belong here, server-side, and NOWHERE ELSE — never in a
# NEXT_PUBLIC_*/EXPO_PUBLIC_* var, never in a client. Both of those prefixes are inlined into the
# client bundle at build time, so a write key there is a public write key, and anyone holding it
# can overwrite or wipe the bucket.
#
# Generate at: R2 → API → Manage API tokens → Create API token
#   Permission: "Object Read & Write" (NOT Admin — that can delete buckets)
#   Scope:      the single bucket below
#
# The endpoint is account-scoped and has no bucket name in it. If the bucket had been created with
# a jurisdiction it would need ".eu." in there; ours wasn't, so it doesn't.
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET="dealsapp"

# What CLIENTS use to READ. Public, safe to expose, and the only R2 value that belongs in a client
# env var. Set it once the bucket has a custom domain attached (R2 → bucket → Settings →
# Custom Domain). The r2.dev URL is rate-limited by Cloudflare and is for smoke tests only.
ASSET_BASE_URL="https://assets.example.ro"

# ── Admin write routes ───────────────────────────────────────────────────────────────────────
#
# The FIRST of two doors on /v1/admin. It proves a request came from the admin app's server-side
# proxy — a browser can't call those routes, and neither can anyone who merely finds the API host.
# It is NOT authentication: it identifies nobody and carries no role. Cloudflare Access below is
# what answers "which person". The value lives server-side in the admin app's proxy (its own
# ADMIN_API_SECRET) and never reaches a bundle. Both sides must match.
#
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
ADMIN_API_SECRET="generate-a-long-random-value"

# Who admin writes are attributed to until there's a real session. `partners.created_by_user_id`
# is NOT NULL — that audit trail is the point — and with no auth there's nobody to ask, so the
# acting admin is named here and resolved server-side. NEVER taken from the request: a
# client-supplied user id makes the audit trail something the caller writes.
#
# Must already exist in `users` as a platform_owner, or writes fail with ACTING_ADMIN_MISSING.
# In dev that's the seed admin — which also means partners created through the UI are cleared by
# the next `db:seed`, since the seed owns rows filed under that account.
ADMIN_ACTING_EMAIL="seed-admin@citydeals.invalid"

# ── Cloudflare Access ────────────────────────────────────────────────────────────────────────
#
# Who is calling /v1/admin. ADMIN_API_SECRET above proves the request came from the admin app's
# proxy; these prove a named person got past Cloudflare Access first. Different questions.
#
# Both from Zero Trust → Access → Applications → your admin app:
#   CF_ACCESS_TEAM_DOMAIN  either "myteam" or "myteam.cloudflareaccess.com" — both work
#   CF_ACCESS_AUD          the application's AUD tag. Per-application, and checking it is what
#                          stops a token for a DIFFERENT app on the same team opening this one.
#
# The verified email must match an active platform_owner in `users`, or the request is 403 —
# getting past Access is authentication, being in that table is authorisation.
#
# ⚠️ THAT ROW IS A DEPLOY PREREQUISITE, and forgetting it is how the first deploy locks you out:
# Access lets you in, the API 403s you, and nothing looks broken on either side. Before pointing a
# deployed admin app at a database, run against it:
#
#   npm run admin:grant -- you@yourprovider.com "Your Name"
#
# with the email your identity provider actually hands to Access, not an alias that forwards.
CF_ACCESS_TEAM_DOMAIN=""
CF_ACCESS_AUD=""

# ⚠️ THE ONLY WAY TO RUN /v1/admin WITHOUT IDENTITY. Local development only.
#
# Cloudflare Access can't reach localhost, so there's no token to verify and no way in without
# this. The API REFUSES TO START if the two variables above are unset and this isn't "yes" —
# deliberately, because "fall back silently when unconfigured" is how a deployed environment ends
# up with authentication switched off and nothing in the logs saying so.
#
# Never set it anywhere it can be deployed. Same posture as ALLOW_SEED, same reasoning.
ALLOW_INSECURE_ADMIN="yes"

# --- Partner dashboard sign-in -------------------------------------------------------------

# Where a magic link points: the ORIGIN of the partner dashboard, no path, no trailing slash.
# http://localhost:3003 in dev, https://partner.<domain> deployed.
#
# Required. It was optional back when an unbuildable link was merely logged; now it's the difference
# between a partner getting a working link and getting silence, so it fails at boot instead.
PARTNER_BASE_URL=http://localhost:3003

# Resend — the only mail path there is. Sign-in links and partner invites both go through it.
#
# ⚠️ Required, with no console fallback. There used to be a LOGIN_LINK_TO_CONSOLE escape hatch that
# printed working sign-in links to stdout; it was deleted along with `npm run partner:link` the day
# this landed, because a service that prints live credentials is one log aggregator away from
# publishing them. Local development uses a real key and a real inbox.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# The From header. Display name optional, address isn't. The sending domain has to be verified in
# Resend (MX + SPF on `send.`, DKIM at `resend._domainkey`) or every send is rejected.
EMAIL_FROM="Crunch <noreply@example.com>"

# ⚠️ DEV ONLY. Drops `Secure` from the partner session cookie. Browsers refuse a Secure cookie over
# plain http, so without this the dashboard on http://localhost:3003 stores nothing and sign-in
# returns 200 while leaving you logged out. Never inferred from NODE_ENV — that's how a session
# cookie ends up in clear text on a staging box.
ALLOW_INSECURE_COOKIE=yes

# ---------------------------------------------------------------------------------------------
# Redemption
# ---------------------------------------------------------------------------------------------

# The ORIGIN of the redeem app — what every QR code points at. No path, no trailing slash.
# The token is appended directly, so a code is <this>/<token>.
#
# ⚠️ On a physical device localhost is the phone itself, so this must be the Mac's LAN IP in dev
# (check with `ipconfig getifaddr en0` — a new DHCP lease silently breaks every QR).
# Deployed it's https://v.crunchapp.ro, never a bare workers.dev host: the staff device cookie is
# bound to whichever hostname enrolled it, so a second origin means every phone redoing its PIN.
REDEEM_BASE_URL=http://localhost:3004

# ⚠️ Echoes the SMS code back in the response and logs it. Local development ONLY.
# There is no SMS provider yet, so without this nobody can verify a phone number at all. With it
# set in a deployed environment, phone verification — the anti-fraud anchor of the product — is a
# formality. It is an explicit opt-in for exactly that reason. Leave it unset anywhere real.
ALLOW_INSECURE_OTP=yes
